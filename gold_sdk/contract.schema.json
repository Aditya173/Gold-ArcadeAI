{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gold.reading.v0",
  "title": "Gold reading",
  "type": "object",
  "required": ["schema", "photos", "signature", "palette", "places", "reliability"],
  "properties": {
    "schema": {"const": "gold.reading.v0"},
    "subject": {"type": "string", "description": "opaque id; never a name"},
    "photos": {"type": "object", "required": ["count", "events"],
               "properties": {"count": {"type": "integer", "minimum": 0}, "events": {"type": "integer", "minimum": 0}}},
    "signature": {"type": "array", "maxItems": 24, "items": {"type": "object",
      "required": ["idea", "share_of_events", "strength", "evidence"],
      "properties": {"idea": {"type": "string", "minLength": 1, "maxLength": 60},
                     "share_of_events": {"type": "number", "minimum": 0, "maximum": 1},
                     "strength": {"type": "number", "minimum": 0, "maximum": 1},
                     "evidence": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
                     "synonyms": {"type": "array", "items": {"type": "string"}}}}},
    "palette": {"type": "array", "maxItems": 12, "items": {"type": "object", "required": ["name", "hex", "share", "source"],
      "properties": {"name": {"type": "string"}, "hex": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
                     "share": {"type": "number", "minimum": 0, "maximum": 1},
                     "source": {"enum": ["lives_with", "goes_to", "saves"]}}}},
    "places": {"type": "array", "items": {"type": "object", "required": ["type", "share_of_events"],
      "properties": {"type": {"type": "string"}, "share_of_events": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "named_places": {"type": "array", "items": {"type": "object", "required": ["label", "events"],
      "properties": {"label": {"type": "string"}, "events": {"type": "integer", "minimum": 1}}}},
    "trips": {"type": "array", "items": {"type": "object", "required": ["place", "start", "end", "events"],
      "properties": {"place": {"type": "string"}, "start": {"type": "string", "format": "date"},
                     "end": {"type": "string", "format": "date"}, "events": {"type": "integer", "minimum": 1}}}},
    "people": {"type": "array", "items": {"type": "object", "required": ["ref", "events"],
      "properties": {"ref": {"type": "string", "pattern": "^person-[0-9]+$"}, "events": {"type": "integer", "minimum": 1}}}},
    "reliability": {"type": "object", "additionalProperties": {"type": "object", "required": ["status"],
      "properties": {"status": {"enum": ["measured", "unmeasured"]}, "value": {"type": "number"},
                     "note": {"type": "string"}}}}
  }
}
