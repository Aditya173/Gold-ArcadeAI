{
  "expo": {
    "name": "Gold × Arcade",
    "slug": "gold-arcade",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "goldarcade",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ai.goldarcade.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose logos and reference images to build your brand style. Only the images you pick are uploaded.",
        "NSCameraUsageDescription": "Take a photo of your logo or a reference image to build your brand style."
      }
    },
    "android": {
      "package": "ai.goldarcade.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose logos and reference images to build your brand style. Only the images you pick are uploaded.",
          "cameraPermission": "Take a photo of your logo or a reference image to build your brand style."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
