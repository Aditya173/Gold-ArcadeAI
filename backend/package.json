{
  "name": "gold-storefront-backend",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "cd functions && npm test",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-storefront \"node --test test/rules.test.js\"",
    "e2e": "firebase emulators:exec --only auth,firestore,functions --project demo-storefront \"node test/e2e.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions --project demo-storefront"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0"
  }
}
