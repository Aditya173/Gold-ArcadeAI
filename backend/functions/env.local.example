# Emulator-only config. Copy to functions/.env.local (gitignored). No secrets: the mock accepts any arcade_sk_live_* key.
ARCADE_BASE_URL=http://127.0.0.1:8787/v1
ARCADE_API_KEY=arcade_sk_live_MOCK
ARCADE_POLL_MS=200
# Planner: unset = offline (recorded plan for creator_maya, template plan for other packs). Set at the hackathon.
# ANTHROPIC_API_KEY=

# Instagram import (POST /instagram/scrape): a Python with gallery-dl + pillow (pip install -r requirements.txt)
PYTHON=../../venv/bin/python
# 1 = serve generated images instead of fetching Instagram (offline demo / tests)
INSTAGRAM_SCRAPE_FAKE=0
