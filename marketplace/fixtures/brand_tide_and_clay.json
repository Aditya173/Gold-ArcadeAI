    {"assetId": "pattern-rings", "kind": "pattern", "mediaType": "image/png", "byteLength": 91233, "describe": "concentric throwing-ring stripes, slightly uneven, clay on oat"},
    {"assetId": "pattern-tide", "kind": "pattern", "mediaType": "image/png", "byteLength": 77410, "describe": "a soft repeating tide-line edge in sea glass"}
